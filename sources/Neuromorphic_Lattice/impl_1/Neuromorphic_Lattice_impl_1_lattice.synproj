# Device Configuration
-a "LIFCL"
-p LIFCL-40
-t CABGA400
-sp "9_High-Performance_1.0V"

# Synthesis Strategy Options
-frequency 200
-optimization_goal Timing
-bram_utilization 100
-ramstyle Auto
-romstyle auto
-dsp_utilization 100
-use_dsp 1
-use_carry_chain 1
-carry_chain_length 0
-resource_sharing 1
-propagate_constants 1
-remove_duplicate_regs 1
-max_fanout 1000
-fsm_encoding_style Auto
-fix_gated_clocks 1
-loop_limit 1950
-use_io_reg auto
-use_dcc_insertion none
-drc_cfg 35103300 20
-use_io_insertion 1
-force_gsr No
-resolve_mixed_drivers 0

# Constraint Files
-sdc "Neuromorphic_Lattice_impl_1_cpe.ldc"

# Search Paths
-path "D:/lscc/radiant/2026.1/ispfpga/je5d00/data"
-path "."
-path ".."
-path "../source/impl_1"

# PMI Library Files
-ver "D:/lscc/radiant/2026.1/ip/pmi/pmi_lifcl.v"
-lib pmi -vhd "D:/lscc/radiant/2026.1/ip/pmi/pmi_lifcl.vhd"

# Source Files
-ver "../source/impl_1/binary_mac_unit.v"
-ver "../source/impl_1/binary_mac_array.v"
-path ".."
-top binary_mac_arry
# Output Configuration
-udb "Neuromorphic_Lattice_impl_1_rtl.udb"
-output_hdl "Neuromorphic_Lattice_impl_1.vm"
